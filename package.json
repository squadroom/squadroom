{
  "name": "squadroom",
  "version": "0.1.0",
  "private": true,
  "description": "A browser console for macOS that runs a team of coding agents as a separate user, each in its own Git clone.",
  "license": "MIT",
  "homepage": "https://squadroom.github.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/squadroom/squadroom.git"
  },
  "bugs": "https://github.com/squadroom/squadroom/issues",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "next build && node scripts/check-build-trace.ts && node scripts/build-stamp.ts",
    "lint": "eslint",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=4 \"tests/*.test.ts\"",
    "test:macos": "node --test --test-concurrency=1 tests/console-launcher.test.ts tests/console-setup-script.test.ts tests/web-server.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "web": "node scripts/web.ts",
    "web:dev": "node scripts/web.ts --dev",
    "update": "zsh scripts/update.sh",
    "emergency": "node scripts/emergency.ts",
    "console:worker": "node scripts/console-worker.ts",
    "console:cleanup": "node scripts/console-cleanup.ts"
  },
  "dependencies": {
    "@next/env": "16.4.5",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.5",
    "typescript": "^5"
  },
  "overrides": {
    "eslint-plugin-import": { "eslint": "$eslint" },
    "eslint-plugin-jsx-a11y": { "eslint": "$eslint" },
    "eslint-plugin-react": { "eslint": "$eslint" },
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  }
}
