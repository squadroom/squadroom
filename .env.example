# Squadroom settings. Copy this file to .env.local and fill it in:
#
#   cp .env.example .env.local
#
# The web server (`npm run web`) reads .env.local through Next.js. The
# Console worker (`npm run console:worker`) reads from these files only the
# backup folder, the e-mail settings and the dead-man's switch; every other
# worker setting comes from its own environment (the LaunchAgent's or the
# shell's). Agent credentials never go here: they live in the key file
# (~/.squadroom/console-keys.json), written by the Keys page.

# ── Sign-in (required) ───────────────────────────────────────────────────
# The https address you open Squadroom at. The web server listens only on
# 127.0.0.1; put an https proxy in front of it (for example Tailscale Serve).
SERVER_PUBLIC_ORIGIN=https://squadroom.example.com

# Your own GitHub OAuth app (GitHub › Settings › Developer settings › OAuth
# Apps). Its callback URL must be <SERVER_PUBLIC_ORIGIN>/api/auth/callback.
SERVER_GITHUB_CLIENT_ID=
SERVER_GITHUB_CLIENT_SECRET=
# The one GitHub account allowed in: its numeric ID, from
# https://api.github.com/users/<your-login> ("id").
SERVER_OWNER_GITHUB_ID=

# Host header of the worker's internal health check: only 127.0.0.1:<port>
# is accepted (`npm run web` sets it to its own port).
# SERVER_INTERNAL_HOST=127.0.0.1:3011
# The folder of the sign-in's store, signin.sqlite (default ~/.squadroom).
# SERVER_SIGNIN_DIR=

# ── E-mail (needed for keys and other weighty actions) ──────────────────
# Your own Resend account (https://resend.com) and a sender on a domain you
# verified there. With all three set:
#   - sign-in has a second step: an 8-digit code e-mailed to
#     CONSOLE_NOTIFY_EMAIL, and weighty Console actions ask for a fresh code;
#   - the worker e-mails you when sign-in locks, a backup fails, or (when
#     you switch it on) the Console has waited 15 minutes for you.
# Without them, GitHub alone signs you in, and weighty actions (every change
# on the Keys page among them) are refused until mail is configured (see
# docs/setup.md).
# CONSOLE_RESEND_API_KEY=
# CONSOLE_MAIL_FROM=Squadroom <squadroom@mail.example.com>
# CONSOLE_NOTIFY_EMAIL=you@example.com

# ── Backups (optional) ───────────────────────────────────────────────────
# A folder for nightly copies of the Console's database (14 days kept).
# CONSOLE_BACKUP_DIR=/Volumes/Backup/squadroom

# ── Dead-man's switch (optional) ─────────────────────────────────────────
# Every 5 minutes the worker checks the web server and pings a
# Healthchecks.io check (keep the URL secret). Both or neither.
# CONSOLE_HEALTHCHECK_URL=https://hc-ping.com/<uuid>
# CONSOLE_WEB_HEALTH_URL=http://127.0.0.1:3011/api/console?health=1

# ── Codex reviews on pull requests (optional, off by default) ───────────
# When on, the worker comments "@codex review" on each pull request it opens
# (and when an agent or Push branch asks again), for repositories that use
# Codex's GitHub reviewer. Restart the worker after changing it.
# CONSOLE_CODEX_REVIEW=on

# ── Paths (optional; defaults shown, as absolute paths) ──────────────────
# The web server reads these from .env.local; the worker reads them only
# from its own environment, so if you move one, set it in both places.
# The agent host's paths must also match what
# scripts/console/setup-agent-user.sh installed: give it the same names
# (sudo CONSOLE_SHARED=… zsh scripts/console/setup-agent-user.sh).
# CONSOLE_STORE=~/.squadroom/console.sqlite
# CONSOLE_KEYS_FILE=~/.squadroom/console-keys.json
# CONSOLE_UPLOADS=~/.squadroom/console/uploads
# CONSOLE_LOG_FILE=~/.squadroom/logs/console.jsonl
# CONSOLE_AGENT_HOME=/Users/agent
# CONSOLE_SHARED=/opt/console-shared
# CONSOLE_LAUNCHER=/usr/local/libexec/console-agent
# CONSOLE_CLIENTS_DIR=/opt/console-clients
